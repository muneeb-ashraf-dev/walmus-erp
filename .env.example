# ===========================================
# Walmus Pharma ERP - Environment Variables
# ===========================================
# Copy this file to .env and update values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://pharma_user:secure_password@localhost:5432/pharma_erp

# Individual components (used for backup scripts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma_erp
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=secure_password

# -----------------------------------------------------------------------------
# BACKEND (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security - CHANGE THESE IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - Only allow local frontend
CORS_ORIGINS=["http://127.0.0.1:3000", "http://localhost:3000"]

# -----------------------------------------------------------------------------
# FRONTEND (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Walmus Pharma ERP

# -----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# -----------------------------------------------------------------------------
BACKUP_DIR=D:/pharma-erp-backups
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Business timezone (Pakistan Standard Time)
APP_TIMEZONE=Asia/Karachi

# Financial year start month (1-12, 7 = July for Pakistan)
FINANCIAL_YEAR_START_MONTH=7

# Default currency
DEFAULT_CURRENCY=PKR

# Expiry alert tiers (days before expiry)
EXPIRY_ALERT_DAYS=90,60,30,7

# Default tax rate (percentage)
DEFAULT_TAX_RATE=0.00

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json